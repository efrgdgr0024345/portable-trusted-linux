[Unit]
Description=Black Cat no-command graphical recovery
ConditionKernelCommandLine=!blackcat.check=1
Conflicts=getty@tty1.service
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/chvt 1
ExecStart=/usr/local/sbin/blackcat-recovery
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=no
